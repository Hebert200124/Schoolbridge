# Flask
FLASK_DEBUG=true                    # Set to true for dev, false/omit for production

# Security
SECRET_KEY=your-random-secret-here  # Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENABLE_SETUP=true                   # Set to true only for first run, then turn off or remove

# Database (defaults to SQLite if not set)
# DATABASE_URL=postgresql://user:password@host:5432/schoolbridge

# Email (SMTP) - for sending reset codes
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your@email.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=noreply@schoolbridge.zw
